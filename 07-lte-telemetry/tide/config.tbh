'=====================================================================
' Рецепт «Телеметрия удалённого объекта по LTE» · настройки
' Четыре «сухих контакта» (дверь, сеть 220 В, авария, резерв) и температура
' в шкафу уходят в MQTT-брокер через сотовую сеть: при изменении входа
' сразу и полным отчётом раз в CFG_REPORT_MIN минут.
'=====================================================================

'--- Сотовая сеть (модем Tibbit #45 в S1-S4) ------------------------------
const CFG_APN = "internet"                  'APN оператора: МТС internet.mts.ru, МегаФон internet, Билайн internet.beeline.ru, Tele2 internet.tele2.ru
const CFG_APN_USER = ""
const CFG_APN_PASSWORD = ""
const CFG_SIM_PIN = "?"                     '"?" - PIN не нужен

'--- MQTT ---------------------------------------------------------------
'Брокер должен быть доступен из интернета (облачный или с белым IP)
const CFG_MQTT_HOST = "broker.example.com"
#define CFG_MQTT_PORT 1883
const CFG_MQTT_USER = ""
const CFG_MQTT_PASSWORD = ""
const CFG_TOPIC_ROOT = "tibbo"
const CFG_DNS_SERVER = "8.8.8.8"

'--- Отчёты -------------------------------------------------------------
#define CFG_REPORT_MIN 15                   'полный отчёт раз в 15 минут (экономия трафика)
#define CFG_TEMP_HIGH 450                   'тревога «перегрев шкафа», десятые доли °C (45.0)

'--- Входы Tibbit #54 в S5 (замкнут = 1) -----------------------------------
const CFG_IN1_NAME = "door"
const CFG_IN2_NAME = "mains_ok"             'например, контакт реле контроля сети: замкнут - 220 В есть
const CFG_IN3_NAME = "alarm"
const CFG_IN4_NAME = "in4"

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
