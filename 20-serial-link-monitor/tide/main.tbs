'=====================================================================
' Рецепт 20 «Прибор на связи?» · события
' Прибор на порту 0. TCP 1001 - прозрачный канал для программы
' (виртуальный COM-порт). HTTP 80 - страница, state.txt, events.csv.
'=====================================================================
include "global.tbh"

dim net_up as no_yes = NO
dim ntp_sock as byte
dim ntp_timer as dword = 0

declare sub net_started()
declare sub ntp_request()
declare sub ser_init()


sub on_sys_init()
	sys.onsystimerperiod = 50           '0,5 с

	dim i, s as byte
	for i = 1 to 2
		s = sock_get("WEB")
		sock.num = s
		sock.protocol = PL_SOCK_PROTOCOL_TCP
		sock.inconmode = PL_SOCK_INCONMODE_ANY_IP_ANY_PORT
		sock.httpmode = YES
		sock.httpportlist = "80"
		sock.connectiontout = 20
		sock.rxbuffrq(1)
		sock.txbuffrq(2)
		sock.varbuffrq(1)
	next i
	mon_init()
	ser_init()
	ntp_sock = sock_get("NTP")
	sntp_init()
	sys.buffalloc()
	ser.num = 0
	ser.enabled = YES

#if CFG_USE_DHCP
	dhcp_start(PL_SOCK_INTERFACE_NET, "", "")
#else
	net.ip = CFG_IP
	net.netmask = CFG_NETMASK
	net.gatewayip = CFG_GATEWAY
	net_started()
#endif
end sub

sub net_started()
	if net_up = YES then exit sub
	net_up = YES
	dbg("Link monitor " + CFG_NAME + ", web: http://" + net.ip + "/")
	ntp_request()
end sub

'порт прибора
sub ser_init()
	ser.num = 0
	ser.enabled = NO
	ser.interface = PL_SER_SI_FULLDUPLEX
	ser.flowcontrol = PL_SER_FC_DISABLED
#if CFG_BAUD >= 9600
	ser.baudrate = ser.div9600 / (CFG_BAUD / 9600)
#else
	ser.baudrate = ser.div9600 * (9600 / CFG_BAUD)
#endif
	ser.parity = CFG_PARITY
	ser.bits = CFG_BITS
	ser.interchardelay = 0
	ser.esctype = PL_SER_ET_DISABLED
	ser.rxbuffrq(2)
	ser.txbuffrq(2)
end sub

sub ntp_request()
	ntp_timer = 0
	if sntp_start(PL_SOCK_INTERFACE_NET, CFG_NTP_SERVER, 123, ntp_sock) <> SNTP_STATUS_OK then
		ntp_timer = CFG_NTP_RESYNC_HOURS * 7200 - 1200     'запрос не ушёл - повтор через 10 минут
	end if
end sub

sub on_sys_timer()
	dhcp_proc_timer()
	sntp_proc_timer()
	mon_tick()
	ntp_timer = ntp_timer + 1
	if net_up = YES and ntp_timer > CFG_NTP_RESYNC_HOURS * 7200 then ntp_request()
end sub

'прибор -> программа: без изменений, попутно отметка «прибор передал данные»
sub on_ser_data_arrival()
	dim s as string(255) = ser.getdata(255)
	mon_from_device(len(s))
	sock.num = raw_sock
	if sock.statesimple = PL_SSTS_EST then
		if sock.txfree >= len(s) then
			sock.setdata(s)
			sock.send()
		end if
	end if
end sub

'программа -> прибор: без изменений, попутно отметка «ждём ответ»
sub on_sock_data_arrival()
	if sock.num = raw_sock then
		dim d as string(255) = sock.getdata(255)
		mon_from_pc(len(d))
		ser.num = 0
		if ser.txfree >= len(d) then
			ser.setdata(d)
			ser.send()
		end if
		exit sub
	end if
	if sock.num = log_sock then
		sock.getdata(255)
		exit sub
	end if
	dhcp_proc_data()
	sntp_proc_data()
end sub

sub on_sock_event(newstate as enum pl_sock_state, newstatesimple as enum pl_sock_state_simple)
	if sock.num = ntp_sock then sntp_proc_sock_event(newstatesimple)
	if sock.num = raw_sock then mon_pc_event(newstatesimple)
end sub

'--- время ---
sub callback_sntp_ok(byref w_days as word, byref w_mins as word, byref b_seconds as byte)
	dim m as long = w_mins
	m = m + CFG_TZ_MINUTES                  'отдельно: иначе сумма считается в 16 битах
	dim d as word = w_days
	if m >= 1440 then
		m = m - 1440
		d = d + 1
	else if m < 0 then
		m = m + 1440
		d = d - 1
	end if
	rtc.setdata(d, m, b_seconds)
	time_ok = YES
end sub

sub callback_sntp_failure(sntp_status as en_sntp_status_codes)
	dbg("SNTP failed, code " + str(sntp_status))
	ntp_timer = CFG_NTP_RESYNC_HOURS * 7200 - 1200
end sub

sub callback_sntp_pre_buffrq(required_buff_pages as byte)
end sub

sub callback_sntp_get_rtc(byref w_days as word, byref w_mins as word, byref b_seconds as byte)
	rtc.getdata(w_days, w_mins, b_seconds)
end sub

'--- сеть ---
sub callback_dhcp_ok(renew as no_yes, interface as pl_sock_interfaces, byref ip as string, byref gateway_ip as string, byref netmask as string, lease_time as dword)
	if renew = YES and net.ip = ip then exit sub
	net.ip = ip
	net.gatewayip = gateway_ip
	net.netmask = netmask
	net_started()
end sub

sub callback_dhcp_failure(interface as pl_sock_interfaces, failure_code as en_dhcp_status_codes)
	dbg("DHCP failed, library will retry")
end sub

sub callback_dhcp_pre_clear_ip(interface as pl_sock_interfaces)
end sub

sub callback_dhcp_pre_buffrq(required_buff_pages as byte)
end sub

sub callback_dhcp_buff_released()
end sub

sub dbg(byref s as string)
#if CFG_DEBUG
	sys.debugprint(s + chr(13) + chr(10))
#endif
end sub
