'=====================================================================
' Рецепт 20 «Прибор на связи?» (DS1101) · настройки
' DS1101 работает как обычный Serial-over-IP: программа на компьютере
' обменивается с прибором через виртуальный COM-порт. Попутно DS1101
' следит за обменом и сообщает в syslog и на страницу, если прибор
' замолчал, перестал отвечать или программа отключилась.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.220"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"
const CFG_NAME = "xray-03"                  'имя прибора - в сообщениях и на странице

'--- Время ---------------------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"
#define CFG_TZ_MINUTES 60                   'смещение от UTC в минутах
#define CFG_NTP_RESYNC_HOURS 12

'--- Порт прибора RS-232 (порт 0 на DB9) ---------------------------------
#define CFG_BAUD 9600
#define CFG_PARITY PL_SER_PR_NONE
#define CFG_BITS PL_SER_BB_8
#define CFG_RAW_PORT 1001                   'прозрачный TCP <-> RS-232 для программы (виртуальный COM-порт)

'--- Что считать сбоем (0 - проверка выключена) ---------------------------
#define CFG_SILENT_MIN 10                   'прибор ничего не передаёт дольше, минут (для приборов, которые шлют данные сами)
#define CFG_REPLY_HALFSEC 4                 'программа отправила запрос, прибор не ответил за столько полусекунд...
#define CFG_REPLY_MISSES 3                  '...столько раз подряд - «прибор не отвечает»
#define CFG_PC_OFF_MIN 5                    'программа не подключена дольше, минут

'--- Сообщения в syslog (UDP) ---------------------------------------------
const CFG_SYSLOG_IP = ""                    'IP сервера syslog (Zabbix, Graylog, rsyslog), пусто - не отправлять
#define CFG_SYSLOG_PORT 514

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
