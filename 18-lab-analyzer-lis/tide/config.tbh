'=====================================================================
' Рецепт 18 «Анализатор -> ЛИС с буфером» (DS1101) · настройки
' Анализатор передаёт результаты по RS-232 протоколом ASTM E1381 (CLSI LIS01).
' DS1101 сам подтверждает каждый кадр, сохраняет его во флеш-памяти и
' пересылает в ЛИС по TCP тем же протоколом. ЛИС недоступна - результаты
' копятся во флеш-памяти и уходят, когда связь вернётся.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.218"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- ЛИС ----------------------------------------------------------------
const CFG_LIS_IP = "192.168.1.10"           'IP сервера ЛИС
#define CFG_LIS_PORT 5000                   'TCP-порт ЛИС для этого анализатора (ASTM E1381 по TCP)
#define CFG_LIS_RETRY_HALFSEC 20            'пауза перед повтором после отказа ЛИС, полусекунд (20 = 10 с)

'--- Порт анализатора RS-232 (порт 0 на DB9) -----------------------------
#define CFG_BAUD 9600
#define CFG_PARITY PL_SER_PR_NONE           'PL_SER_PR_NONE / PL_SER_PR_EVEN / PL_SER_PR_ODD
#define CFG_BITS PL_SER_BB_8                'PL_SER_BB_8 / PL_SER_BB_7

'--- Буфер во флеш-памяти -------------------------------------------------
'Один кадр ASTM (до 240 символов) - один сектор флеш-памяти. Сектора пишутся
'по кругу, поэтому износ распределяется равномерно по всему буферу.
#define CFG_LOG_SECTORS 1024                'сколько секторов отдать под буфер (не больше fd.availableflashspace)
#define CFG_MIN_FREE 16                     'меньше свободных секторов - новую передачу от анализатора не принимаем (NAK)

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
