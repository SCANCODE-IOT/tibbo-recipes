# Скопируйте в .env и замените все change-me. Файл .env в git не кладите.
TZ=Europe/Moscow

INFLUX_USER=admin
INFLUX_PASSWORD=change-me-long-password
INFLUX_ORG=oss
INFLUX_BUCKET=oss
INFLUX_RETENTION=365d
# токен InfluxDB: любая длинная случайная строка, например: openssl rand -hex 32
INFLUX_TOKEN=change-me-token

GRAFANA_PASSWORD=change-me-grafana

# оповещения в Telegram: токен бота от @BotFather и номер чата. Пусто - без оповещений
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# пороги: величина -> min и/или max; hyst - на сколько вернуться, чтобы тревога снялась
THRESHOLDS={"temperature":{"max":30,"hyst":1},"humidity":{"max":70,"hyst":3},"co2":{"max":1500,"hyst":100},"BAT_LVL":{"min":20,"hyst":5}}
# через сколько минут без данных сообщить «нет связи»
NODATA_MIN=90
