'=====================================================================
' Рецепт 22 «Гирлянды и подсветка по закату» · настройки
' Плата TPP2(G2): #17 в S1 (три канала 12 В с ШИМ), #03-1 в S3 (два реле
' для катушек установочных реле или контакторов 230 В), #20 в S2+S4,
' #09 в S11 и #18 в S12 (питание 12 В).
' Всё, что здесь задано, кроме сети и отладки, меняется и на веб-странице
' контроллера и хранится в EEPROM. Значения ниже - только до первого сохранения.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1                      '1 - адрес по DHCP, 0 - статический адрес ниже
const CFG_IP = "192.168.1.202"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Время --------------------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера (time.cloudflare.com); можно IP роутера
#define CFG_NTP_RESYNC_HOURS 12             'как часто сверять время

'--- Место: по нему считаются восход и закат ----------------------------
'Широта и долгота в десятитысячных долях градуса: Москва 55,7558 с. ш., 37,6173 в. д.
#define CFG_DEF_LAT_E4 557558
#define CFG_DEF_LON_E4 376173
#define CFG_DEF_TZ_MINUTES 180              'часовой пояс: UTC+3 = 180

'--- Расписание ---------------------------------------------------------
#define CFG_DEF_SUNSET_SHIFT 0              'включение: закат + N минут (можно отрицательное: -15 - за 15 минут до заката)
#define CFG_DEF_OFF 60                      'выключение, минуты от полуночи: 01:00 = 60
#define CFG_DEF_MORNING 0                   '1 - включать и утром, до восхода
#define CFG_DEF_MORNING_ON 390              'утреннее включение: 06:30 = 390
#define CFG_DEF_NY_NIGHT 1                  '1 - в ночь на 1 января гореть до утра

'--- Светодиодные ленты 12 В на Tibbit #17 ------------------------------
'Только одноцветные ленты и гирлянды (два провода): ключи #17 стоят в плюсовом проводе.
'RGB-лента с общим плюсом к #17 не подключится.
#define CFG_DEF_EFFECT 3                    '0 ровно, 1 дыхание, 2 бегущие огни, 3 перелив, 4 мерцание
#define CFG_DEF_BRIGHT 80                   'яркость, % (10-100)
#define CFG_DEF_SPEED 3                     'скорость эффектов 1-5

'Названия групп для веб-страницы (UTF-8, до 24 символов)
const CFG_NAME1 = "Гирлянды 230 В (реле 1)"
const CFG_NAME2 = "Подсветка фасада (реле 2)"
const CFG_NAME3 = "Ленты 12 В, #17"

'--- Веб ----------------------------------------------------------------
#define CFG_HTTP_PORT "80"

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
