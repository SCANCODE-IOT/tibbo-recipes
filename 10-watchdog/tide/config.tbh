'=====================================================================
' Рецепт «Сторожевой узел: проверка связи и перезагрузка по питанию»
' Контроллер проверяет, отвечают ли устройства и интернет (TCP-подключение
' к адресу и порту). Если канал не отвечает несколько проверок подряд,
' реле разрывает питание устройства (контакт NC) и через паузу включает.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 0                      'сторожу лучше статический адрес
const CFG_IP = "192.168.1.210"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Канал 1 (реле 1): например, роутер. Проверяем доступ в интернет ----
const CFG_CH1_NAME = "router"
const CFG_CH1_HOST1 = "8.8.8.8"             'IP:порт; DNS-серверы принимают TCP на порт 53
#define CFG_CH1_PORT1 53
const CFG_CH1_HOST2 = "1.1.1.1"
#define CFG_CH1_PORT2 53
#define CFG_CH1_ENABLED 1

'--- Канал 2 (реле 2): например, IP-камера или коммутатор -----------------
const CFG_CH2_NAME = "camera"
const CFG_CH2_HOST1 = "192.168.1.64"
#define CFG_CH2_PORT1 80
const CFG_CH2_HOST2 = ""                    'пусто - второй адрес не проверяется
#define CFG_CH2_PORT2 80
#define CFG_CH2_ENABLED 1

'--- Логика -------------------------------------------------------------
#define CFG_CHECK_PERIOD_S 30               'проверка раз в 30 с
#define CFG_CONNECT_TIMEOUT_S 5             'ожидание подключения
#define CFG_FAILS_TO_REBOOT 4               'сколько неудачных проверок подряд (4 x 30 с = 2 мин)
#define CFG_POWER_OFF_S 10                  'сколько секунд держать питание выключенным
#define CFG_BOOT_WAIT_S 180                 'сколько ждать загрузки устройства после включения
#define CFG_MAX_REBOOTS 3                   'перезагрузок подряд без восстановления, затем пауза
#define CFG_LONG_PAUSE_MIN 60               'пауза после серии неудачных перезагрузок

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
