'=====================================================================
' Рецепт 14 «Сварочный пост: учёт времени работы сварщика» · общий заголовок
' Плата TPP2(G2): #05 (RS-485) в S1, #04-5 (изолированные входы 24 В) в S5,
' #33 (питание 24 В) в S11. Библиотеки Tibbo 2_01_05
'=====================================================================
include "config.tbh"

#define MQTT_DEBUG_PRINT 0
#define MQTT_RX_BUFF 2
#define MQTT_TX_BUFF 4
#define DHCP_DEBUG_PRINT 0
#define DNS_DEBUG_PRINT 0
#define SNTP_DEBUG_PRINT 0
#define DNS_DEFAULT_SERVER CFG_DNS_SERVER

include "sock\trunk\sock.tbh"
include "dns\trunk\dns.tbh"
include "dhcp\trunk\dhcp.tbh"
include "sntp\trunk\sntp.tbh"
include "mqtt\trunk\mqtt.tbh"

#define J_SIZE 62                           'сколько суток хранит журнал
#define NO_MIN 65535                        'время не задано
#define NO_E 4294967295                     'энергия неизвестна

'--- Wi-Fi не используется: заглушка для библиотеки DHCP на платформе TPP2W(G2) ---
declare function wln_check_association() as pl_wln_association_states

enum pt_types
	PT_U16,
	PT_S16,
	PT_U32,
	PT_S32,
	PT_F32
end enum

'--- main.tbs ---
declare sub dbg(byref s as string)
declare function dev_id() as string
declare sub app_point_value(idx as byte, byref value as string)
declare sub app_point_error(idx as byte, code as byte)
declare sub app_cycle_done(ok_count as byte, err_count as byte)
declare sub app_arc_changed()
declare sub app_day_closed(slot as byte)
declare mqtt_online as no_yes
declare ntp_ok as no_yes

'--- modbus_rtu.tbs ---
declare sub mb_init()
declare sub point_add(slave as byte, func as byte, addr as word, ptype as pt_types, divider as word, byref pname as string, writable as no_yes)
declare sub mb_start_cycle()
declare sub mb_proc_timer()
declare sub mb_proc_data()
declare function mb_find_point(byref pname as string) as byte
declare function mb_write_point(idx as byte, byref value as string) as ok_ng
declare function mb_point_name(idx as byte) as string
declare function mb_point_value(idx as byte) as string
declare pt_count as byte

'--- weld.tbs: учёт ---
declare sub weld_init()
declare sub weld_proc_tick()
declare sub weld_set_clock(days as word, mins as word, secs as byte)
declare sub weld_meter_energy(byref v as string)
declare sub weld_meter_power(byref v as string)
declare sub weld_meter_lost()
declare function weld_clock_str() as string
declare function weld_date_str(d as word) as string
declare function weld_hhmm(m as word) as string
declare function weld_hms(s as dword) as string
declare function weld_kwh(e as dword) as string
declare function weld_day_energy() as dword
declare function weld_j_next(prev as word) as byte
declare arc_on as no_yes
declare time_ok as no_yes
declare cur_day as word
declare d_arc_ms as dword
declare d_work_s as dword
declare d_starts as word
declare d_first as word
declare d_last as word
declare in_session as no_yes
declare m_ok as no_yes
declare m_power as long
declare j_day(J_SIZE) as word
declare j_arc(J_SIZE) as dword
declare j_work(J_SIZE) as word
declare j_starts(J_SIZE) as word
declare j_first(J_SIZE) as word
declare j_last(J_SIZE) as word
declare j_e(J_SIZE) as dword

'--- web.tbs ---
declare function web_arg(byref rq as string, byref argname as string) as string
declare sub web_send(byref s as string)
declare sub web_handle_set(byref rq as string)
declare function web_parse_hhmm(byref s as string) as word
