'=====================================================================
' Рецепт 14 «Сварочный пост: учёт времени работы сварщика» · события
' MQTT: <root>/<id>/arc (0|1, сразу при изменении), раз в минуту -
' arc_s, work_min, starts, kwh_day, power_w, status; при закрытии суток - day (JSON).
'=====================================================================
include "global.tbh"

dim mqtt_online as no_yes = NO
dim ntp_ok as no_yes = NO
dim net_ready as no_yes = NO
dim lib_tick as byte = 0
dim slow_tick as byte = 0
dim poll_ms as dword = 0
dim min_ms as dword = 0
dim ntp_sock as byte
dim ntp_timer as dword = 0
dim topic_base as string(48)
dim app_mqtt_host as string(64) = CFG_MQTT_HOST
dim app_mqtt_user as string(32) = CFG_MQTT_USER
dim app_mqtt_pass as string(32) = CFG_MQTT_PASSWORD
dim app_mqtt_cid as string(32)

declare sub net_started()
declare sub ntp_request()
declare sub publish(byref name as string, byref value as string)
declare sub publish_minute()

sub on_sys_init()
	'сторожевой таймер: сбрасываем сами из on_sys_timer, зависание приложения - перезагрузка
	sys.wdperiod = 1000
	sys.wdautoreset = DISABLED
	sys.wdenabled = YES
	sys.onsystimerperiod = 1             '10 мс: слежение за дугой

	topic_base = CFG_TOPIC_ROOT + "/" + dev_id() + "/"
	app_mqtt_cid = "tibbo-" + dev_id()

	'два сокета под веб-сервер
	dim i, s as byte
	for i = 1 to 2
		s = sock_get("WEB")
		sock.num = s
		sock.protocol = PL_SOCK_PROTOCOL_TCP
		sock.inconmode = PL_SOCK_INCONMODE_ANY_IP_ANY_PORT
		sock.httpmode = YES
		sock.httpportlist = "80"
		sock.rxbuffrq(1)
		sock.txbuffrq(8)
		sock.varbuffrq(1)
	next i
	sys.buffalloc()

#if CFG_USE_METER
	mb_init()
	point_add(CFG_METER_ADDR, CFG_METER_FUNC, CFG_REG_ENERGY, PT_F32, 1, "energy", NO)
	point_add(CFG_METER_ADDR, CFG_METER_FUNC, CFG_REG_POWER, PT_F32, 1, "power", NO)
#endif
	weld_init()

	ntp_sock = sock_get("NTP")
	sntp_init()
	dns_start(sock_get("DNS"))
#if CFG_USE_DHCP
	dhcp_start(PL_SOCK_INTERFACE_NET, "", "")
#else
	net.ip = CFG_IP
	net.netmask = CFG_NETMASK
	net.gatewayip = CFG_GATEWAY
	net_started()
#endif
	poll_ms = sys.timercountms
	min_ms = sys.timercountms
end sub

sub net_started()
	if net_ready = YES then exit sub
	net_ready = YES
	dbg("Welding post, web: http://" + net.ip + "/")
	ntp_request()
#if CFG_USE_MQTT
	mqtt_start(PL_SOCK_INTERFACE_NET, app_mqtt_host, CFG_MQTT_PORT, app_mqtt_user, app_mqtt_pass, app_mqtt_cid, false)
#endif
end sub

sub ntp_request()
	ntp_timer = sys.timercountms
	sntp_start(PL_SOCK_INTERFACE_NET, CFG_NTP_SERVER, 123, ntp_sock)
end sub

sub on_sys_timer()
	sys.wdreset()
	weld_proc_tick()
	slow_tick = slow_tick + 1
	if slow_tick < 10 then exit sub
	slow_tick = 0
	'всё остальное - раз в 100 мс
#if CFG_USE_METER
	mb_proc_timer()
	if sys.timercountms - poll_ms >= CFG_POLL_PERIOD_MS then
		poll_ms = sys.timercountms
		mb_start_cycle()
	end if
#endif
	if sys.timercountms - min_ms >= 60000 then
		min_ms = min_ms + 60000
		publish_minute()
	end if
	'библиотеки DHCP, DNS, SNTP и MQTT рассчитаны на вызов раз в 0,5 с
	lib_tick = lib_tick + 1
	if lib_tick < 5 then exit sub
	lib_tick = 0
	dhcp_proc_timer()
	dns_proc_timer()
	sntp_proc_timer()
#if CFG_USE_MQTT
	mqtt_proc_timer()
#endif
	if net_ready = YES and sys.timercountms - ntp_timer > CFG_NTP_RESYNC_HOURS * 3600000 then ntp_request()
end sub

sub on_ser_data_arrival()
#if CFG_USE_METER
	if ser.num = CFG_RS485_PORT then mb_proc_data()
#endif
end sub

sub on_sock_data_arrival()
	dhcp_proc_data()
	dns_proc_data()
	sntp_proc_data()
#if CFG_USE_MQTT
	mqtt_proc_data()
#endif
end sub

sub on_sock_event(newstate as enum pl_sock_state, newstatesimple as enum pl_sock_state_simple)
	if sock.num = ntp_sock then sntp_proc_sock_event(newstatesimple)
#if CFG_USE_MQTT
	mqtt_sock_event(newstate, newstatesimple)
#endif
end sub

'--- счётчик электроэнергии: точка 0 - энергия, точка 1 - мощность ---
sub app_point_value(idx as byte, byref value as string)
	if idx = 0 then
		weld_meter_energy(value)
	else
		weld_meter_power(value)
	end if
end sub

sub app_point_error(idx as byte, code as byte)
	dbg("Meter: point " + str(idx) + ", error " + str(code))
end sub

sub app_cycle_done(ok_count as byte, err_count as byte)
end sub

'--- MQTT ---
sub publish(byref name as string, byref value as string)
#if CFG_USE_MQTT
	if mqtt_online = NO then exit sub
	dim t as string(96) = topic_base + name
	mqtt_publish(t, value, QOS_AT_MOST_ONCE)
#endif
end sub

sub app_arc_changed()
	if arc_on = YES then
		publish("arc", "1")
	else
		publish("arc", "0")
	end if
end sub

sub publish_minute()
	publish("arc_s", lstr(d_arc_ms / 1000))
	publish("work_min", lstr(d_work_s / 60))
	publish("starts", str(d_starts))
#if CFG_USE_METER
	if weld_day_energy() <> NO_E then publish("kwh_day", weld_kwh(weld_day_energy()))
	if m_ok = YES then
		publish("power_w", lstr(m_power))
		publish("status", "online")
	else
		publish("status", "online, no meter")
	end if
#else
	publish("status", "online")
#endif
end sub

'итог суток одним сообщением: {"date":"13.11.2026","arc_s":5400,"work_min":310,"starts":212,"first":"08:12","last":"16:47","kwh":38.52}
sub app_day_closed(slot as byte)
	dim s as string(160)
	dim q as string(1) = chr(34)
	s = "{" + q + "date" + q + ":" + q + weld_date_str(j_day(slot)) + q + "," + q + "arc_s" + q + ":" + lstr(j_arc(slot)) + "," + q + "work_min" + q + ":" + str(j_work(slot)) + "," + q + "starts" + q + ":" + str(j_starts(slot))
	s = s + "," + q + "first" + q + ":" + q + weld_hhmm(j_first(slot)) + q + "," + q + "last" + q + ":" + q + weld_hhmm(j_last(slot)) + q
	if j_e(slot) <> NO_E then s = s + "," + q + "kwh" + q + ":" + weld_kwh(j_e(slot))
	s = s + "}"
	publish("day", s)
	dbg("Day closed: " + s)
end sub

sub callback_mqtt_connect_ok()
	mqtt_online = YES
	dbg("MQTT: connected")
	app_arc_changed()
end sub

sub callback_mqtt_connect_lost()
	mqtt_online = NO
	dbg("MQTT: connection lost, library will reconnect")
end sub

sub callback_mqtt_sub_ok()
end sub

sub callback_mqtt_notif(byref topic as string, byref data as string, remaining_bytes as dword)
end sub

'--- время ---
sub callback_sntp_ok(byref w_days as word, byref w_mins as word, byref b_seconds as byte)
	dim m as long = w_mins + CFG_TZ_MINUTES
	dim d as word = w_days
	if m >= 1440 then
		m = m - 1440
		d = d + 1
	else if m < 0 then
		m = m + 1440
		d = d - 1
	end if
	weld_set_clock(d, m, b_seconds)
	ntp_ok = YES
	dbg("SNTP ok: " + weld_clock_str())
end sub

sub callback_sntp_failure(sntp_status as en_sntp_status_codes)
	dbg("SNTP failed, code " + str(sntp_status))
	ntp_timer = sys.timercountms - CFG_NTP_RESYNC_HOURS * 3600000 + 600000     'повтор через 10 минут
end sub

sub callback_sntp_pre_buffrq(required_buff_pages as byte)
end sub

'--- сеть ---
sub callback_dhcp_ok(renew as no_yes, interface as pl_sock_interfaces, byref ip as string, byref gateway_ip as string, byref netmask as string, lease_time as dword)
	if renew = YES and net.ip = ip then exit sub
	net.ip = ip
	net.gatewayip = gateway_ip
	net.netmask = netmask
	net_started()
end sub

sub callback_dhcp_failure(interface as pl_sock_interfaces, failure_code as en_dhcp_status_codes)
	dbg("DHCP failed, library will retry")
end sub

sub callback_dhcp_pre_clear_ip(interface as pl_sock_interfaces)
end sub

sub callback_dhcp_pre_buffrq(required_buff_pages as byte)
end sub

sub callback_dhcp_buff_released()
end sub

sub callback_dns_failure(status as en_dns_status_codes)
end sub

sub callback_dns_answer_acquired(return_type as en_dns_return_type, byref return_string as string)
#if CFG_USE_MQTT
	mqtt_dns_answer_acquired(return_type, return_string)
#endif
end sub

sub callback_dns_ok()
end sub

sub callback_dns_pre_buffrq(num_of_pages_required as byte)
end sub

sub callback_dns_buff_released()
end sub

function wln_check_association() as pl_wln_association_states
	wln_check_association = PL_WLN_NOT_ASSOCIATED
end function

'id устройства из MAC: 0.36.119.81.127.23 -> 002477517F17
function dev_id() as string
	dim m as string(24) = net.mac
	dim part as string(4) = ""
	dim i as byte
	dim c as string(1)
	dev_id = ""
	for i = 1 to len(m) + 1
		if i <= len(m) then
			c = mid(m, i, 1)
		else
			c = "."
		end if
		if c = "." then
			dim h as string(8) = hex(val(part))
			h = right(h, len(h) - 2)
			if len(h) < 2 then h = "0" + h
			dev_id = dev_id + h
			part = ""
		else
			part = part + c
		end if
	next i
end function

sub dbg(byref s as string)
#if CFG_DEBUG
	sys.debugprint(s + chr(13) + chr(10))
#endif
end sub
