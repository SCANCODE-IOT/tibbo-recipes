'=====================================================================
' Рецепт 14 «Сварочный пост: учёт времени работы сварщика» · настройки
' Контроллер по току аппарата видит, горит ли дуга, и считает за сутки:
' время дуги, время в работе, число зажиганий и электроэнергию.
' Всё, что зависит от объекта, собрано в этом файле.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1                      '1 - адрес от роутера, 0 - адрес ниже
const CFG_IP = "192.168.1.214"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"
const CFG_DNS_SERVER = "8.8.8.8"            'нужен, только если брокер MQTT задан именем

'--- Время --------------------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера (time.cloudflare.com); можно IP роутера или сервера завода
#define CFG_TZ_MINUTES 180                  'смещение от UTC в минутах: UTC+3 = 180
#define CFG_NTP_RESYNC_HOURS 12             'как часто сверять время
#define CFG_DAY_START_MIN 0                 'начало учётных суток, минут от полуночи: 0 - в 00:00, 480 - в 08:00

'--- Дуга ---------------------------------------------------------------
'Откуда брать признак «дуга горит»:
' 0 - вход 1 Tibbit #04-5: контакт реле тока на питающем кабеле аппарата (надёжнее и точнее)
' 1 - мощность по счётчику электроэнергии выше CFG_ARC_POWER_W (без реле тока, точность около 1 с)
#define CFG_ARC_SOURCE 0
#define CFG_ARC_ON_MS 50                    'ток держится дольше - дуга зажглась (защита от помех)
#define CFG_ARC_OFF_MS 500                  'тока нет дольше - дуга погасла; короче - тот же шов продолжается
#define CFG_ARC_POWER_W 1500                'для CFG_ARC_SOURCE 1: мощность, выше которой считаем, что идёт сварка
#define CFG_BREAK_MIN 15                    'пауза между швами короче - сварщик в работе; длиннее - перерыв

'--- Счётчик электроэнергии (Modbus RTU, Tibbit #05 в S1) ------------------
#define CFG_USE_METER 1                     '0 - счётчика нет, считаем только время
#define CFG_RS485_PORT 0
#define CFG_RS485_BAUD 9600
#define CFG_RS485_PARITY PL_SER_PR_NONE     'PL_SER_PR_NONE / PL_SER_PR_EVEN / PL_SER_PR_ODD
#define CFG_METER_ADDR 1                    'адрес счётчика на линии
#define CFG_METER_FUNC 4                    '4 - input registers, 3 - holding registers
'Регистры (номер с нуля), значения float из двух регистров. По умолчанию - карта Eastron:
'энергия всего 342 (SDM120 и SDM630), мощность 12 (SDM120, однофазный) или 52 (SDM630, сумма трёх фаз)
#define CFG_REG_ENERGY 342                  'энергия нарастающим итогом, кВт*ч
#define CFG_REG_POWER 12                    'активная мощность, Вт
#define CFG_POLL_PERIOD_MS 2000             'опрос счётчика; для CFG_ARC_SOURCE 1 поставьте 1000
#define CFG_REPLY_TIMEOUT_MS 500
#define CFG_METER_LOST_S 30                 'нет ответа дольше - на странице «нет связи со счётчиком»
#define CFG_MAX_POINTS 4
#define CFG_PUBLISH_ON_CHANGE_ONLY 0
#define CFG_REPUBLISH_EVERY 1

'--- MQTT (можно выключить: учёт останется на веб-странице) ---------------
#define CFG_USE_MQTT 1
const CFG_MQTT_HOST = "192.168.1.10"        'IP или имя брокера
#define CFG_MQTT_PORT 1883
const CFG_MQTT_USER = ""
const CFG_MQTT_PASSWORD = ""
const CFG_TOPIC_ROOT = "tibbo"              'топики: tibbo/<id>/<имя>

'--- Хранение -----------------------------------------------------------
const CFG_POST_NAME = "Пост 1"              'название поста для веб-страницы и CSV
#define CFG_SAVE_MINUTES 5                  'как часто сохранять счётчики текущих суток в память
#define CFG_POWER_FAIL_INPUT 1              '1 - источник #33: сохранять счётчики по его сигналу «питание пропадает»; 0 - другой источник (#09, #10)

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
