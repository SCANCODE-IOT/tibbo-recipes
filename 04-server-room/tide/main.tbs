'=====================================================================
' Рецепт «Мониторинг серверной» · события
' MQTT: <root>/<id>/temperature, humidity, alarm (0 - норма, иначе маска),
' alarm_text, status. Команды: <root>/<id>/ack (любое значение) - квитировать,
' <root>/<id>/relay2/set 1|0.
'=====================================================================
include "global.tbh"

dim mqtt_online as no_yes = NO
dim sec_ms as dword = 0
dim pub_alarms as word = 65535
dim net_ready as no_yes = NO
dim tick as byte = 0
dim poll_ms as dword = 0
dim min_ms as dword = 0
dim topic_base as string(48)
dim app_mqtt_host as string(64) = CFG_MQTT_HOST
dim app_mqtt_user as string(32) = CFG_MQTT_USER
dim app_mqtt_pass as string(32) = CFG_MQTT_PASSWORD
dim app_mqtt_cid as string(32)

declare sub net_started()

sub on_sys_init()
	sys.wdperiod = 1000
	sys.wdautoreset = DISABLED
	sys.wdenabled = YES
	sys.onsystimerperiod = 10            '100 мс

	pat.play("G-G-------", PL_PAT_CANINT)
	topic_base = CFG_TOPIC_ROOT + "/" + dev_id() + "/"
	app_mqtt_cid = "tibbo-" + dev_id()

	'два сокета под веб-сервер
	dim i, s as byte
	for i = 1 to 2
		s = sock_get("WEB")
		sock.num = s
		sock.protocol = PL_SOCK_PROTOCOL_TCP
		sock.inconmode = PL_SOCK_INCONMODE_ANY_IP_ANY_PORT
		sock.httpmode = YES
		sock.httpportlist = "80"
		sock.rxbuffrq(1)
		sock.txbuffrq(8)
		sock.varbuffrq(1)
	next i
	sys.buffalloc()

	mb_init()
	point_add(CFG_SENSOR_ADDR, CFG_SENSOR_FUNC, CFG_REG_TEMP, PT_S16, 10, "temperature", NO)
	point_add(CFG_SENSOR_ADDR, CFG_SENSOR_FUNC, CFG_REG_HUM, PT_U16, 10, "humidity", NO)
	mon_init()

	dns_start(sock_get("DNS"))
#if CFG_USE_DHCP
	dhcp_start(PL_SOCK_INTERFACE_NET, "", "")
#else
	net.ip = CFG_IP
	net.netmask = CFG_NETMASK
	net.gatewayip = CFG_GATEWAY
	net_started()
#endif
	poll_ms = sys.timercountms
	sec_ms = sys.timercountms
end sub

sub net_started()
	if net_ready = YES then exit sub
	net_ready = YES
	pat.play("~G", PL_PAT_CANINT)
	dbg("Server room monitor, web: http://" + net.ip + "/")
#if CFG_USE_MQTT
	mqtt_start(PL_SOCK_INTERFACE_NET, app_mqtt_host, CFG_MQTT_PORT, app_mqtt_user, app_mqtt_pass, app_mqtt_cid, false)
#endif
end sub

sub on_sys_timer()
	sys.wdreset()
	mon_proc_tick()
	mb_proc_timer()
	if sys.timercountms - poll_ms >= CFG_POLL_PERIOD_MS then
		poll_ms = sys.timercountms
		mb_start_cycle()
	end if
	if sys.timercountms - sec_ms >= 1000 then
		sec_ms = sec_ms + 1000
		mon_proc_second()
#if CFG_USE_MQTT
		if mqtt_online = YES and mon_alarms <> pub_alarms then
			dim t as string(96) = topic_base + "alarm"
			mqtt_publish(t, str(mon_alarms), QOS_AT_LEAST_ONCE)
			t = topic_base + "alarm_text"
			dim at as string(160) = mon_alarm_text(mon_alarms)
			if at = "" then at = "OK"
			mqtt_publish(t, at, QOS_AT_LEAST_ONCE)
			pub_alarms = mon_alarms
		end if
#endif
	end if
	tick = tick + 1
	if tick >= 5 then
		tick = 0
		dhcp_proc_timer()
		dns_proc_timer()
#if CFG_USE_MQTT
		mqtt_proc_timer()
#endif
	end if
end sub

sub on_ser_data_arrival()
	if ser.num = CFG_RS485_PORT then mb_proc_data()
end sub

sub on_sock_data_arrival()
	dhcp_proc_data()
	dns_proc_data()
#if CFG_USE_MQTT
	mqtt_proc_data()
#endif
end sub

sub on_sock_event(newstate as enum pl_sock_state, newstatesimple as enum pl_sock_state_simple)
#if CFG_USE_MQTT
	mqtt_sock_event(newstate, newstatesimple)
#endif
end sub

'--- значения -> MQTT ---
sub app_point_value(idx as byte, byref value as string)
	if idx = 0 then
		mon_set_temp(value)
	else
		mon_set_hum(value)
	end if
#if CFG_USE_MQTT
	dim t as string(96)
	if mqtt_online = NO then exit sub
	t = topic_base + mb_point_name(idx)
	mqtt_publish(t, value, QOS_AT_MOST_ONCE)
#endif
end sub

sub app_point_error(idx as byte, code as byte)
	dbg("Sensor " + mb_point_name(idx) + ": error " + str(code))
end sub

sub app_cycle_done(ok_count as byte, err_count as byte)
#if CFG_USE_MQTT
	dim t as string(96)
	if mqtt_online = NO then exit sub
	t = topic_base + "status"
	mqtt_publish(t, "online err=" + str(err_count), QOS_AT_MOST_ONCE)
#endif
end sub

'--- MQTT ---
sub callback_mqtt_connect_ok()
	dim t as string(96)
	mqtt_online = YES
	pub_alarms = 65535
	dbg("MQTT: connected")
	t = topic_base + "ack"
	mqtt_sub(t, QOS_AT_MOST_ONCE)
	t = topic_base + "relay2/set"
	mqtt_sub(t, QOS_AT_MOST_ONCE)
end sub

sub callback_mqtt_connect_lost()
	mqtt_online = NO
	dbg("MQTT: connection lost, library will reconnect")
end sub

sub callback_mqtt_sub_ok()
end sub

sub callback_mqtt_notif(byref topic as string, byref data as string, remaining_bytes as dword)
	if topic = topic_base + "ack" then
		mon_ack()
	else if topic = topic_base + "relay2/set" then
		if data = "1" or data = "on" then
			mon_set_relay2(YES)
		else
			mon_set_relay2(NO)
		end if
	end if
end sub

'--- сеть ---
sub callback_dhcp_ok(renew as no_yes, interface as pl_sock_interfaces, byref ip as string, byref gateway_ip as string, byref netmask as string, lease_time as dword)
	if renew = YES and net.ip = ip then exit sub
	net.ip = ip
	net.gatewayip = gateway_ip
	net.netmask = netmask
	net_started()
end sub

sub callback_dhcp_failure(interface as pl_sock_interfaces, failure_code as en_dhcp_status_codes)
	dbg("DHCP failed, library will retry")
end sub

sub callback_dhcp_pre_clear_ip(interface as pl_sock_interfaces)
end sub

sub callback_dhcp_pre_buffrq(required_buff_pages as byte)
end sub

sub callback_dhcp_buff_released()
end sub

sub callback_dns_failure(status as en_dns_status_codes)
end sub

sub callback_dns_answer_acquired(return_type as en_dns_return_type, byref return_string as string)
#if CFG_USE_MQTT
	mqtt_dns_answer_acquired(return_type, return_string)
#endif
end sub

sub callback_dns_ok()
end sub

sub callback_dns_pre_buffrq(num_of_pages_required as byte)
end sub

sub callback_dns_buff_released()
end sub

function wln_check_association() as pl_wln_association_states
	wln_check_association = PL_WLN_NOT_ASSOCIATED
end function

function dev_id() as string
	dim m as string(24) = net.mac
	dim part as string(4) = ""
	dim i as byte
	dim c as string(1)
	dev_id = ""
	for i = 1 to len(m) + 1
		if i <= len(m) then
			c = mid(m, i, 1)
		else
			c = "."
		end if
		if c = "." then
			dim h as string(8) = hex(val(part))
			h = right(h, len(h) - 2)
			if len(h) < 2 then h = "0" + h
			dev_id = dev_id + h
			part = ""
		else
			part = part + c
		end if
	next i
end function

sub dbg(byref s as string)
#if CFG_DEBUG
	sys.debugprint(s + chr(13) + chr(10))
#endif
end sub
