'=====================================================================
' Рецепт «Мониторинг серверной» · настройки
' Температура и влажность (датчик RS-485 Modbus), протечка, дверь и ещё
' два «сухих контакта», сирена/маячок и второе реле, веб-страница, MQTT.
' Пороги меняются на веб-странице и хранятся в памяти контроллера.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.203"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"
const CFG_DNS_SERVER = "8.8.8.8"

'--- MQTT ---------------------------------------------------------------
#define CFG_USE_MQTT 1
const CFG_MQTT_HOST = "192.168.1.10"
#define CFG_MQTT_PORT 1883
const CFG_MQTT_USER = ""
const CFG_MQTT_PASSWORD = ""
const CFG_TOPIC_ROOT = "tibbo"

'--- Датчик температуры и влажности RS-485 (Tibbit #05 в S1) -----------
'По умолчанию - распространённые датчики на SHT20/SHT30 с Modbus RTU
'(XY-MD02 и аналоги): адрес 1, функция 4, регистр 1 - температура x10,
'регистр 2 - влажность x10. Для другого датчика поправьте значения ниже.
#define CFG_RS485_PORT 0
#define CFG_RS485_BAUD 9600
#define CFG_RS485_PARITY PL_SER_PR_NONE
#define CFG_SENSOR_ADDR 1
#define CFG_SENSOR_FUNC 4
#define CFG_REG_TEMP 1
#define CFG_REG_HUM 2
#define CFG_POLL_PERIOD_MS 5000
#define CFG_REPLY_TIMEOUT_MS 500
#define CFG_MAX_POINTS 4
#define CFG_PUBLISH_ON_CHANGE_ONLY 0
#define CFG_REPUBLISH_EVERY 12

'--- Пороги по умолчанию (дальше - с веб-страницы), десятые доли ----------
#define CFG_DEF_T_HIGH 300                  '30.0 °C
#define CFG_DEF_T_LOW 100                   '10.0 °C
#define CFG_DEF_H_HIGH 700                  '70.0 %
#define CFG_DEF_H_LOW 200                   '20.0 %
#define CFG_ALARM_DELAY_S 60                'сколько секунд порог должен быть нарушен
#define CFG_SENSOR_LOST_S 60                'нет ответа датчика дольше - тревога

'--- Входы Tibbit #54 в S9 (замкнут = сработал) ---------------------------
'1 - датчик протечки, 2 - дверь (концевик: замкнут при закрытой двери),
'3 и 4 - свободные (дым, ИБП «работа от батарей» и т.п.)
#define CFG_DOOR_NC 1                       '1 - вход 2 замкнут при закрытой двери
const CFG_IN3_NAME = "input3"
const CFG_IN4_NAME = "input4"

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
