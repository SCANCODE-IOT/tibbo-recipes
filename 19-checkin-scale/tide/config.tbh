'=====================================================================
' Рецепт 19 «Багажные весы на стойке регистрации» (DS1101) · настройки
' Весы RS-232 -> DS1101. Программа регистрации получает данные весов как
' раньше, через виртуальный COM-порт (прозрачный TCP). Дополнительно DS1101
' фиксирует каждое взвешивание, отмечает перевес, следит, что весы на нуле
' и на связи, и отдаёт журнал и состояние по HTTP.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.219"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"
const CFG_COUNTER = "A12"                   'номер стойки - попадает в журнал и в сообщения

'--- Время ---------------------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера; в аэропорту - внутренний сервер времени
#define CFG_TZ_MINUTES 60                   'смещение от UTC в минутах: UTC+1 = 60
#define CFG_NTP_RESYNC_HOURS 12

'--- Порт весов RS-232 (порт 0 на DB9) ----------------------------------
#define CFG_BAUD 9600
#define CFG_PARITY PL_SER_PR_NONE
#define CFG_BITS PL_SER_BB_8
const CFG_POLL_CMD = ""                     'весы «по запросу»: команда, например "W" + chr(13). Пусто - весы шлют вес сами
#define CFG_POLL_HALFSEC 1
const CFG_STABLE_MARK = "ST"                'признак стабильного веса в строке весов. Пусто - каждый вес стабильный
#define CFG_RAW_PORT 1001                   'прозрачный TCP <-> RS-232 для программы регистрации (виртуальный COM-порт)

'--- Взвешивание --------------------------------------------------------
#define CFG_MIN_G 1000                      'взвешиванием считается вес от 1 кг
#define CFG_ZERO_G 200                      'вес меньше - багаж сняли, ждём следующий
#define CFG_STABLE_HALFSEC 3                'вес стабилен столько полусекунд подряд - фиксируем
#define CFG_LIMIT1_G 23000                  'первый порог (обычная норма багажа), г
#define CFG_LIMIT2_G 32000                  'второй порог (предел одного места у многих авиакомпаний), г
#define CFG_ZERO_WARN_G 100                 'пустые весы показывают больше - «весы не на нуле»
#define CFG_ZERO_WARN_HALFSEC 120           'сколько это должно длиться, полусекунд (120 = 1 мин)
#define CFG_SILENT_HALFSEC 10               'нет строк от весов дольше - «весы не на связи»

'--- Сообщение о каждом взвешивании (UDP) --------------------------------
const CFG_UDP_IP = ""                       'IP сборщика, пусто - не отправлять
#define CFG_UDP_PORT 5140

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
