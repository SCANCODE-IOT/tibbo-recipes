'=====================================================================
' Рецепт «Учёт электроэнергии и воды» · общий заголовок
' Плата TPP2(G2): #05 (RS-485) в S1, #54 (импульсные входы) в S9, #09 в S11
' Библиотеки Tibbo 2_01_05
'=====================================================================
include "config.tbh"

#define MQTT_DEBUG_PRINT 0
#define MQTT_RX_BUFF 2
#define MQTT_TX_BUFF 4
#define DHCP_DEBUG_PRINT 0
#define DNS_DEBUG_PRINT 0
#define DNS_DEFAULT_SERVER CFG_DNS_SERVER

include "sock\trunk\sock.tbh"
include "dns\trunk\dns.tbh"
include "dhcp\trunk\dhcp.tbh"
include "mqtt\trunk\mqtt.tbh"

#define W_COUNT 4

'--- Wi-Fi не используется: заглушка для библиотеки DHCP на платформе TPP2W(G2) ---
declare function wln_check_association() as pl_wln_association_states

enum pt_types
	PT_U16,
	PT_S16,
	PT_U32,
	PT_S32,
	PT_F32
end enum

'--- main.tbs ---
declare sub dbg(byref s as string)
declare function dev_id() as string
declare sub app_point_value(idx as byte, byref value as string)
declare sub app_point_error(idx as byte, code as byte)
declare sub app_cycle_done(ok_count as byte, err_count as byte)
declare mqtt_online as no_yes
declare mb_errors as byte

'--- config.tbs ---
declare sub config_points()

'--- modbus_rtu.tbs ---
declare sub mb_init()
declare sub point_add(slave as byte, func as byte, addr as word, ptype as pt_types, divider as word, byref pname as string, writable as no_yes)
declare sub mb_start_cycle()
declare sub mb_proc_timer()
declare sub mb_proc_data()
declare function mb_find_point(byref pname as string) as byte
declare function mb_write_point(idx as byte, byref value as string) as ok_ng
declare function mb_point_name(idx as byte) as string
declare function mb_point_value(idx as byte) as string
declare pt_count as byte

'--- pulse.tbs ---
declare sub pulse_init()
declare sub pulse_proc_tick()
declare sub pulse_proc_minute()
declare sub pulse_set_m3(ch as byte, byref m3 as string)
declare function pulse_m3(ch as byte) as string
declare function pulse_name(ch as byte) as string

'--- web.tbs ---
declare function web_arg(byref rq as string, byref argname as string) as string
declare sub web_send(byref s as string)
declare sub web_handle_set(byref rq as string)
