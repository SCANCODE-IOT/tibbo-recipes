'=====================================================================
' Точки опроса счётчиков электроэнергии (Modbus RTU).
' point_add(адрес прибора, функция, регистр, тип, делитель, "имя", можно писать)
'   функция: 3 - holding registers, 4 - input registers
'   регистр: адрес с нуля (30001 -> 0, 30343 -> 342)
'   тип: PT_U16, PT_S16 (1 регистр), PT_U32, PT_S32, PT_F32 (2 регистра, старшее слово первым)
'   делитель: значение делится на него (100 -> 12345 станет 123.45)
' Пример: однофазный счётчик с адресом 1 и картой регистров как у Eastron SDM120
' (напряжение, ток, мощность, накопленная энергия, кВт*ч). Для своего счётчика
' возьмите адреса из его карты регистров Modbus.
'=====================================================================
include "global.tbh"

sub config_points()
	point_add(1, 4, 0, PT_F32, 1, "meter1/voltage", NO)
	point_add(1, 4, 6, PT_F32, 1, "meter1/current", NO)
	point_add(1, 4, 12, PT_F32, 1, "meter1/power", NO)
	point_add(1, 4, 342, PT_F32, 1, "meter1/energy_kwh", NO)
end sub
