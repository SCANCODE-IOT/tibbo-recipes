'=====================================================================
' Рецепт «СКУД на одну дверь» · настройки
' Считыватель Wiegand (26 или 34 бита), замок, кнопка выхода, датчик двери,
' вход пожарной сигнализации, список карт и журнал на веб-странице.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.205"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Доступ к веб-странице ---------------------------------------------
'Смените пароль перед установкой. Вход действует до перезагрузки контроллера.
const CFG_WEB_PASSWORD = "tibbo1234"

'--- Дверь --------------------------------------------------------------
#define CFG_UNLOCK_S 5                      'сколько секунд замок открыт после карты или кнопки
#define CFG_HELD_OPEN_S 30                  'дверь открыта дольше - тревога «дверь не закрыта»
#define CFG_ALARM_S 30                      'сколько секунд держать реле тревоги (сирена)
#define CFG_DOOR_SENSOR 1                   '1 - датчик двери подключён ко входу 2
#define CFG_FIRE_INPUT 1                    '1 - вход 3: замкнут = пожарная тревога, дверь открыта

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
