'=====================================================================
' Рецепт 16 «Подбор по свету с ТСД» · настройки
' ТСД (CipherLab, Point Mobile или любой Android-терминал с браузером)
' сканирует код товара, у нужной ячейки загорается лампа, работник
' берёт товар и нажимает кнопку ячейки.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.217"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Время (для журнала) ------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера (time.cloudflare.com); можно IP роутера или сервера
#define CFG_TZ_MINUTES 180                  'смещение от UTC в минутах: UTC+3 = 180
#define CFG_NTP_RESYNC_HOURS 12

'--- Стеллаж -----------------------------------------------------------
const CFG_RACK_NAME = "Стеллаж 1"           'имя на странице ТСД
#define CFG_CELLS 8                         'ячеек на контроллер (лампы на двух #11, кнопки на двух #04-8)
#define CFG_DEBOUNCE 3                      'кнопка нажата столько тактов по 20 мс подряд
#define CFG_WRONG_BLINK 1                   '1 - при нажатии кнопки без задания мигнуть лампой этой ячейки

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
