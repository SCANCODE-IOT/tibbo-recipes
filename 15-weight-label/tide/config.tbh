'=====================================================================
' Рецепт 15 «Этикетка по весу на принтер Godex» · настройки
' Весы RS-232 -> DS1101 -> принтер этикеток Godex по сети (TCP 9100, EZPL).
' Товар, срок годности и режим печати меняются на веб-странице.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.215"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Время (для даты упаковки и срока годности) ------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера (time.cloudflare.com); можно IP роутера или сервера
#define CFG_TZ_MINUTES 180                  'смещение от UTC в минутах: UTC+3 = 180
#define CFG_NTP_RESYNC_HOURS 12             'как часто сверять время

'--- Порт весов RS-232 (порт 0 на DB9) ----------------------------------
#define CFG_BAUD 9600
#define CFG_PARITY PL_SER_PR_NONE           'PL_SER_PR_NONE / PL_SER_PR_EVEN / PL_SER_PR_ODD
#define CFG_BITS PL_SER_BB_8                'PL_SER_BB_8 / PL_SER_BB_7
const CFG_POLL_CMD = ""                     'весы «по запросу»: команда, например "P" + chr(13) + chr(10). Пусто - весы шлют вес сами
#define CFG_POLL_HALFSEC 1                  'период запроса, в полусекундах
const CFG_STABLE_MARK = "ST"                'признак стабильного веса в строке весов. Пусто - каждый вес стабильный

'--- Принтер Godex -------------------------------------------------------
const CFG_PRN_IP = "192.168.1.216"          'IP принтера (задайте на принтере статический адрес)
#define CFG_PRN_PORT 9100                   'порт печати RAW
#define CFG_PRN_CHECK 1                     '1 - перед печатью спросить состояние (~S,CHECK); 0 - печатать без проверки
#define CFG_DOTS_MM 8                       'точек на мм: 8 для 203 dpi, 12 для 300 dpi
#define CFG_LABEL_W 58                      'ширина этикетки, мм
#define CFG_LABEL_H 40                      'высота этикетки, мм
#define CFG_LABEL_GAP 3                     'зазор между этикетками, мм
#define CFG_DARKNESS 10                     'плотность печати 0-19
#define CFG_SPEED 3                         'скорость печати, дюймов в секунду
const CFG_TTF = ""                          'шрифт TrueType: пусто - встроенный; буква A-Z - шрифт, загруженный в принтер

'--- Автопечать ---------------------------------------------------------
#define CFG_MIN_G 20                        'печатать, только если вес не меньше, г
#define CFG_ZERO_G 10                       'вес меньше - товар сняли, можно печатать следующую этикетку, г
#define CFG_STABLE_HALFSEC 2                'вес должен быть стабильным столько полусекунд подряд
const CFG_EAN_PREFIX = "22"                 'префикс весового штрихкода EAN-13 (20-29, уточните в учётной системе)

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
