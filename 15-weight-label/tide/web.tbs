'=====================================================================
' Веб: разбор запроса, вывод по частям, сохранение товара и часов
' set.html?n=<название>&p=<артикул>&d=<срок, сут>&m=a|m
' set.html?t=2026-11-13T14:30 - установить часы
'=====================================================================
include "global.tbh"

function web_arg(byref rq as string, byref argname as string) as string
	dim key as string(16)
	dim i, j as word
	web_arg = ""
	'в строке запроса TiOS нет "?": она начинается с первого параметра, например "t=...&x=... HTTP/1.1"
	key = argname + "="
	if left(rq, len(key)) = key then
		i = 1
	else
		key = "?" + argname + "="
		i = instr(1, rq, key, 1)
	end if
	if i = 0 then
		key = "&" + argname + "="
		i = instr(1, rq, key, 1)
	end if
	if i = 0 then exit function
	i = i + len(key)
	j = i
	while j <= len(rq)
		dim c as string(1) = mid(rq, j, 1)
		if c = "&" or c = " " then goto done
		j = j + 1
	wend
done:
	web_arg = mid(rq, i, j - i)
end function

'%D0%9F -> байты UTF-8, + -> пробел
function web_decode(byref s as string) as string
	dim i as byte = 1
	dim c as string(1)
	web_decode = ""
	while i <= len(s)
		c = mid(s, i, 1)
		if c = "%" and i + 2 <= len(s) then
			web_decode = web_decode + chr(val("&h" + mid(s, i + 1, 2)))
			i = i + 3
		else
			if c = "+" then c = " "
			web_decode = web_decode + c
			i = i + 1
		end if
	wend
end function

'обрезать до n байт, не разрезая букву UTF-8; управляющие символы и ^ ~ (команды EZPL) убрать
function web_clean(byref s as string, n as byte) as string
	dim i as byte
	dim c as string(1)
	web_clean = ""
	for i = 1 to len(s)
		c = mid(s, i, 1)
		if asc(c) >= 32 and c <> "^" and c <> "~" then web_clean = web_clean + c
	next i
	if len(web_clean) <= n then exit function
	i = n + 1
	'байты 0x80-0xBF - продолжение буквы: отступаем до её начала
	while i > 1 and asc(mid(web_clean, i, 1)) >= &h80 and asc(mid(web_clean, i, 1)) < &hC0
		i = i - 1
	wend
	web_clean = left(web_clean, i - 1)
end function

'экранирование для вывода в HTML
function web_html(byref s as string) as string
	dim i as byte
	dim c as string(1)
	web_html = ""
	for i = 1 to len(s)
		c = mid(s, i, 1)
		if c = "<" then
			web_html = web_html + "&lt;"
		else if c = ">" then
			web_html = web_html + "&gt;"
		else if c = "&" then
			web_html = web_html + "&amp;"
		else if c = chr(34) then
			web_html = web_html + "&quot;"
		else
			web_html = web_html + c
		end if
	next i
end function

'вывод части страницы: ждём место в буфере сокета
sub web_send(byref s as string)
	dim hs as byte = sock.num
	while sock.txfree < len(s)
		sock.send()
		doevents
		sock.num = hs                       'за время doevents другой код мог выбрать другой сокет
	wend
	sock.setdata(s)
	sock.send()
end sub

function web_parse_hhmm(byref s as string) as word
	dim t as string(16) = s
	dim p as byte = instr(1, t, "%3A", 1)
	if p > 0 then t = left(t, p - 1) + ":" + mid(t, p + 3, 2)
	p = instr(1, t, ":", 1)
	web_parse_hhmm = 0
	if p < 2 then exit function
	dim h as word = val(left(t, p - 1))
	dim m as word = val(mid(t, p + 1, 2))
	if h > 23 or m > 59 then exit function
	web_parse_hhmm = h * 60 + m
end function

sub web_handle_set(byref rq as string)
	dim t as string(24) = web_arg(rq, "t")
	if t <> "" then
		'2026-11-13T14%3A30 или 2026-11-13T14:30
		dim y as byte = val(mid(t, 3, 2))
		dim mo as byte = val(mid(t, 6, 2))
		dim dd as byte = val(mid(t, 9, 2))
		dim tm as string(8) = mid(t, 12, 8)
		if y > 0 and mo > 0 and mo < 13 and dd > 0 and dd < 32 then
			dim d as word = daycount(y, mo, dd)
			if date(d) = dd then label_set_clock(d, web_parse_hhmm(tm), 0)     '31.02 и подобные - не ставим
		end if
		exit sub
	end if
	dim raw as string(200) = web_arg(rq, "n")
	if raw = "" then exit sub
	dim dec as string(200) = web_decode(raw)
	dim name as string(64) = web_clean(dec, 60)
	dim plu as string(8) = web_arg(rq, "p")
	dim i as byte
	'артикул - только цифры
	for i = 1 to len(plu)
		if mid(plu, i, 1) < "0" or mid(plu, i, 1) > "9" then exit sub
	next i
	if plu = "" or len(plu) > 5 then exit sub
	dim days as word = val(web_arg(rq, "d"))
	dim auto as no_yes = YES
	if web_arg(rq, "m") = "m" then auto = NO
	if name = "" then exit sub
	label_save_product(name, plu, days, auto)
end sub
