'=====================================================================
' Веб-страница: разбор запроса, вывод по частям, команды
' set.html?m=0|1|2 - режим (выкл / авто / вентиляция), f=50 - ручная скорость, %
' set.html?sp=22.0&hy=1.0&pb=3.0&rh=60 - уставки
'=====================================================================
include "global.tbh"

function web_arg(byref rq as string, byref argname as string) as string
	dim key as string(16)
	dim i, j as byte
	web_arg = ""
	key = "?" + argname + "="
	i = instr(1, rq, key, 1)
	if i = 0 then
		key = "&" + argname + "="
		i = instr(1, rq, key, 1)
	end if
	if i = 0 then exit function
	i = i + len(key)
	j = i
	while j <= len(rq)
		dim c as string(1) = mid(rq, j, 1)
		if c = "&" or c = " " then goto done
		j = j + 1
	wend
done:
	web_arg = mid(rq, i, j - i)
end function

sub web_send(byref s as string)
	while sock.txfree < len(s)
		sock.send()
		doevents
	wend
	sock.setdata(s)
	sock.send()
end sub

sub web_handle_set(byref rq as string)
	dim m as string(4) = web_arg(rq, "m")
	if m <> "" then
		dim mv as byte = val(m)
		if mv <= TM_VENT then th_mode = mv
		dim f as string(4) = web_arg(rq, "f")
		if f <> "" and val(f) <= 100 then th_manual_fan = val(f)
		th_save()
		th_proc_second()
		exit sub
	end if
	dim sp as string(8) = web_arg(rq, "sp")
	if sp = "" then exit sub
	dim v as integer
	v = strtof(sp) * 10
	if v >= 50 and v <= 350 then th_setpoint = v
	v = strtof(web_arg(rq, "hy")) * 10
	if v >= 2 and v <= 50 then th_hyst = v
	v = strtof(web_arg(rq, "pb")) * 10
	if v >= 5 and v <= 200 then th_pband = v
	v = strtof(web_arg(rq, "rh")) * 10
	if v >= 200 and v <= 950 then th_rh_max = v
	th_save()
end sub

function web_tenth(v as integer) as string
	dim a as word
	dim s as string(8) = ""
	if v < 0 then
		s = "-"
		a = 0 - v
	else
		a = v
	end if
	web_tenth = s + str(a / 10) + "." + str(a mod 10)
end function
