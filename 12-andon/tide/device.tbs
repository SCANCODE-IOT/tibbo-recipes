dim register_address as word=request_item.start_register
'****callback_modbus_slave_reply_timeout****'
end sub

function modbus_create_data(func_type as modbusFunc, data as string) as string
    modbus_create_data=""
    select case func_type
        case WriteSingleCoil
            dim tmp_value as byte=val(data)
            if tmp_value=1 then
                modbus_create_data=chr(&hFF) + chr(&h00)
            else 
                modbus_create_data=chr(&h00) + chr(&h00)
            end if
        case PresetSingleRegister
            dim tmp_value as word=val(data)
            if tmp_value < 0 then
                tmp_value=tmp_value+65536
            end if
            modbus_create_data=chr(tmp_value SHR 8)+chr(tmp_value AND &hFF)
            
    end select
end function

sub delay_handler()
    if delay_has_active then
        dim delay_count as byte=0
        dim sys_timer_count_ms as dword=sys.timercountms
        '****delay_handler****'
        
            if delay_mw9uwva6jclxqu4 > 0 then
                if sys_timer_count_ms > delay_mw9uwva6jclxqu4 then
                    delay_mw9uwva6jclxqu4 = 0
                    '****mw9uwva6jclxqu4_delay_elapsed****'
                    var_horn_set((1<>0))
                    
                else
                    delay_count = delay_count + 1
                end if
            end if
        
        if delay_count=0 AND delay_has_active = false then
            delay_has_active = false
        end if
    end if
end sub
        
