end sub
        

sub callback_sntp_ok(byref w_days as word,byref w_mins as word,byref b_seconds as byte)
    td_gmt_to_local(w_days,w_mins,APP_TIMEZONE,PL_OFF)
    #IF RTC_AVAILABLE
    rtc.setdata(w_days,w_mins,b_seconds)
    #ENDIF
    '****callback_sntp_ok****'
    
        datetime_timer_offset=datetime_current_timestamp() - sys.timercountms/1000
        'set crontabs
        if CRON_MAX_SCHEDULES>0 then
            dim i as byte
            for i=0 to CRON_MAX_SCHEDULES-1
                crons(i).next_timestamp=0
            next i
        end if
        
end sub
        

sub callback_sntp_pre_buffrq(required_buff_pages as byte)
    '****callback_sntp_pre_buffrq****'
end sub
        

sub callback_cron_expired(index as byte)
    '****callback_cron_expired****'
    
        select case index
        
                case 0:
                    sys.debugprint("CRON> shift_day triggered")
                    cron_expired_shift_day()
                
                case 1:
                    sys.debugprint("CRON> shift_night triggered")
                    cron_expired_shift_night()
                
            case else:
        end select
end sub

sub cron_check_tabs()
    if CRON_MAX_SCHEDULES=0 then
        exit sub
    end if
    dim i as byte=0
    for i=0 to CRON_MAX_SCHEDULES-1
        if crons(i).next_timestamp=0 then
            dim timestamp as dword=datetime_next_cron(crons(i))
            dim dstr as string=datetime_timestamp_to_string(timestamp,"YYYY-MM-DD hh:mm tt")
            sys.debugprint("CRON> next schedule at " + str(i) + " to " + dstr)
            crons(i).next_timestamp=timestamp
        else
            if sys.timercountms/1000 + datetime_timer_offset > crons(i).next_timestamp then
                crons(i).next_timestamp=0
                callback_cron_expired(i)
            end if
        end if
    next i
end sub

