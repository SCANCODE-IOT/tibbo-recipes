sub callback_modbus_slave_reply(byref request_item as modbus_request_item, byref reply as string)
dim bytes as byte(255) = reply
dim short_data as short
dim data as float = 0
dim device_id as word=request_item.device_id
dim register_address as word=request_item.start_register
dim response_data as word=0
select case request_item.request_function
    case ReadCoilStatus,ReadInputStatus,WriteSingleCoil,WriteMultipleCoils:
        response_data=bytes(0) AND 1
    case ReadHoldingRegisters,ReadInputRegisters,PresetSingleRegister,PresetMultipleRegisters:
        response_data=(bytes(0) SHL 8) OR bytes(1)

end select


'****callback_modbus_slave_reply****'
end sub

