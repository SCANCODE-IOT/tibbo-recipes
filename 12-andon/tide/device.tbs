sub var_state_update()
    '****var_state_update****'
end sub
            

sub var_state_update_completed(value as float)
    dim value_old as float = state
    '****var_state_update_completed****'
    
    
    state=value
    if value_old <> state then
        var_state_changed(value_old)
        #if VARIABLES_DEBUG_PRINT
            sys.debugprint("VAR> state changed from " + ftofixed(value_old,4) + " to " +  ftofixed(state,4) + "\r\n")
        #endif
    end if
    '****var_state_updated****'
end sub
            

sub var_state_set(value as float)
    
    
    dim value_old as float = state
    state=value
    
    '****var_state_set****'

    if value_old <> state then
        #if VARIABLES_DEBUG_PRINT
            sys.debugprint("VAR> state changed from " + ftofixed(value_old,4) + " to " +  ftofixed(state,4) + "\r\n")
        #endif
        var_state_changed(value_old)
    end if
end sub
            

sub var_state_changed(value_old as float)
    '****var_state_changed****'
end sub
            

