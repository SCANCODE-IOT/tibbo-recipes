sub on_sys_init()
    boot()
end sub

'****EVENTS****'

sub on_sys_timer()
'****on_sys_timer****'

dim sys_timercountms as dword = sys.timercountms
#IF SYS_VER <> 1000 AND WATCHDOG_ENABLED
    sys.wdreset()
#ENDIF

    dhcp_proc_timer()

    if sys_timercountms >= var_poll_timer then
        var_poll_timer = sys_timercountms + 1000
        '****var_poll_timer_elapsed****'
        
            '****var_poll_timer_state_elapsed****'
        
            '****var_poll_timer_parts_elapsed****'
        
            '****var_poll_timer_stops_elapsed****'
        
            '****var_poll_timer_min_run_elapsed****'
        
            '****var_poll_timer_min_call_elapsed****'
        
            '****var_poll_timer_min_alarm_elapsed****'
        
            '****var_poll_timer_NETNM_elapsed****'
        
            '****var_poll_timer_NETGW_elapsed****'
        
            '****var_poll_timer_TZONE_elapsed****'
        
            '****var_poll_timer_NETCP_elapsed****'
        
            '****var_poll_timer_NETIP_elapsed****'
        
            '****var_poll_timer_WBPWD_elapsed****'
        
            '****var_poll_timer_lamp_green_elapsed****'
            var_lamp_green_update()
        
            '****var_poll_timer_lamp_yellow_elapsed****'
            var_lamp_yellow_update()
        
            '****var_poll_timer_lamp_red_elapsed****'
            var_lamp_red_update()
        
            '****var_poll_timer_horn_elapsed****'
            var_horn_update()
        
            '****var_poll_timer_btn_run_elapsed****'
            var_btn_run_update()
        
            '****var_poll_timer_btn_call_elapsed****'
            var_btn_call_update()
        
            '****var_poll_timer_btn_alarm_elapsed****'
            var_btn_alarm_update()
        
            '****var_poll_timer_cycle_elapsed****'
            var_cycle_update()
        
            '****var_poll_timer_LPART_elapsed****'
        
            '****var_poll_timer_LSTOP_elapsed****'
        
            '****var_poll_timer_LRUN_elapsed****'
        
            '****var_poll_timer_LCALL_elapsed****'
        
            '****var_poll_timer_LALRM_elapsed****'
    end if
	sntp_proc_timer()

    cron_check_tabs()

http_server_proc_timer()
	dns_proc_timer()

    modbus_proc_timer()

delay_handler()


    timer_60s_mw9uwvc4v6wv0tk_count = timer_60s_mw9uwvc4v6wv0tk_count + 1
    if timer_60s_mw9uwvc4v6wv0tk_count > timer_60s_mw9uwvc4v6wv0tk_timer then
        '****mw9uwvc4v6wv0tk_timer_tick****'
        
            if state = 0 then
                '****mw9uwvcbl7zk61y_true_output****'
                var_min_run_set(min_run + 1)
                
            else
                '****mw9uwvcbl7zk61y_false_output****'
                
                    if state = 1 then
                        '****mw9uwvdv5mdn6w7_true_output****'
                        var_min_call_set(min_call + 1)
                        
                    else
                        '****mw9uwvdv5mdn6w7_false_output****'
                        var_min_alarm_set(min_alarm + 1)
                        
                    end if
            end if
        timer_60s_mw9uwvc4v6wv0tk_count = 0
    end if

end sub


sub on_sock_data_arrival()
'****on_sock_data_arrival****'
    dhcp_proc_data()
	sntp_proc_data()

http_server_proc_sock_data()
	dns_proc_data()

end sub


sub on_net_link_change()
'****on_net_link_change****'

    if net.linkstate=PL_NET_LINKSTAT_NOLINK then
        interface_set(PL_SOCK_INTERFACE_NET,NO)
        '****callback_net_disconnected****'
    else
        if net_dhcp_enabled = false then
            interface_set(PL_SOCK_INTERFACE_NET,YES)
        end if
    end if

end sub


sub on_sock_event(newstate as pl_sock_state,newstatesimple as pl_sock_state_simple)
'****on_sock_event****'
	sntp_proc_sock_event(newstate)

http_server_proc_sock_event(newstate,newstatesimple)

end sub


sub on_sock_data_sent()
'****on_sock_data_sent****'

http_server_proc_sock_data_sent()

#IFDEF TBL_MAX_NUM_TABLES
tables_web_proc_sock_data_sent()
#ENDIF

end sub


sub on_kp(key_event as pl_kp_event_codes, key_code as byte)
'****on_kp****'

    if key_event=PL_KP_EVENT_PRESSED and key_code = btn_run_kp then
        '****mw9uwuozkaz0lg1_on_kp****'
        cmd_SET_RUN("")
                    

    end if

    if key_event=PL_KP_EVENT_PRESSED and key_code = btn_call_kp then
        '****mw9uwuprmw3fdpp_on_kp****'
        cmd_SET_CALL("")
                    

    end if

    if key_event=PL_KP_EVENT_PRESSED and key_code = btn_alarm_kp then
        '****mw9uwuqjqmc3l00_on_kp****'
        cmd_SET_ALARM("")
                    

    end if

    if key_event=PL_KP_EVENT_PRESSED and key_code = cycle_kp then
        '****mw9uwvbcqv6n46v_on_kp****'
        var_parts_set(parts + 1)
        

    end if

end sub

