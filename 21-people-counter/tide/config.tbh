'=====================================================================
' Рецепт 21 «Счётчик посетителей» (модуль EM510) · настройки
' Два ИК-луча у входа: какой перекрыт первым - туда и шли. Входы и
' выходы по часам, журнал во внешней флеш-памяти, страница и CSV.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1
const CFG_IP = "192.168.1.221"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"
const CFG_NAME = "entrance-1"               'название входа - на странице, в CSV и сообщениях

'--- Время ---------------------------------------------------------------
'У EM510 нет часов с батарейкой: время берётся с SNTP-сервера при включении и раз в 12 часов
const CFG_NTP_SERVER = "162.159.200.1"
#define CFG_TZ_MINUTES 180                  'смещение от UTC в минутах
#define CFG_NTP_RESYNC_HOURS 12

'--- Датчики --------------------------------------------------------------
'Луч A - со стороны улицы, луч B - со стороны зала. A, потом B - вход; B, потом A - выход
#define CFG_BEAM_A PL_IO_NUM_0_INT0
#define CFG_BEAM_B PL_IO_NUM_2
#define CFG_BLOCKED_LEVEL LOW               'уровень на линии, когда луч перекрыт (зависит от датчика и оптрона)
#define CFG_DEBOUNCE 3                      'столько опросов по 10 мс подряд - состояние луча изменилось
#define CFG_PASS_TIMEOUT 300                'проход дольше, сотых секунды (300 = 3 с), не считается

'--- Журнал ---------------------------------------------------------------
'Внешняя флеш-память AT45DB041 на GPIO1, GPIO3, GPIO4 (схема Tibbo). Одна запись - один час
#define CFG_LOG_SECTORS 4000                'не больше fd.availableflashspace
#define CFG_CSV_HOURS 168                   'сколько последних часов отдаёт counts.csv (168 = неделя)
#define CFG_SAVE_MIN 5                      'как часто сохранять счётчик текущего часа в EEPROM, минут

'--- Сообщение раз в час (UDP) --------------------------------------------
const CFG_UDP_IP = ""                       'IP сборщика, пусто - не отправлять
#define CFG_UDP_PORT 5141

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
