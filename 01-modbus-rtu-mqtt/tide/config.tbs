'=====================================================================
' Точки опроса: какие регистры каких приборов читать и как их назвать.
' point_add(адрес прибора, функция, регистр, тип, делитель, "имя", можно писать)
'   функция: 3 - holding registers, 4 - input registers
'   регистр: адрес с нуля, как в документации прибора (40001 -> 0, 30005 -> 4)
'   тип: PT_U16, PT_S16 (1 регистр), PT_U32, PT_S32, PT_F32 (2 регистра, старшее слово первым)
'   делитель: значение делится на него перед публикацией (10 -> 235 станет 23.5)
'   можно писать: YES - значение можно изменить из MQTT (только PT_U16/PT_S16, функция 3)
' Пример ниже: счётчик электроэнергии с адресом 1 и термостат с адресом 2.
'=====================================================================
include "global.tbh"

sub config_points()
	point_add(1, 4, 0, PT_F32, 1, "meter1/voltage", NO)
	point_add(1, 4, 6, PT_F32, 1, "meter1/current", NO)
	point_add(1, 4, 12, PT_F32, 1, "meter1/power", NO)
	point_add(1, 4, 342, PT_F32, 1, "meter1/energy", NO)
	point_add(2, 3, 0, PT_S16, 10, "room/temperature", NO)
	point_add(2, 3, 10, PT_U16, 10, "room/setpoint", YES)
end sub
