'=====================================================================
' Рецепт 13 «Чёрный ящик RS-485»
' Контроллер молча слушает линию RS-485, хранит последние кадры и
' замораживает их снимок в момент сбоя: ошибка CRC, ответ-исключение
' Modbus или тишина на линии. Сам в линию ничего не передаёт.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1                      '1 - адрес от роутера, 0 - адрес ниже
const CFG_IP = "192.168.1.213"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Линия RS-485 (Tibbit #05 в сокете S1, порт ser.num = 0) ------------
#define CFG_RS485_PORT 0
#define CFG_RS485_BAUD 9600                 '1200 ... 115200
#define CFG_RS485_PARITY PL_SER_PR_NONE     'PL_SER_PR_NONE, PL_SER_PR_EVEN, PL_SER_PR_ODD

'--- Когда замораживать снимок ------------------------------------------
#define CFG_TRIG_CRC 1                      'кадр с неверной контрольной суммой
#define CFG_TRIG_EXCEPTION 1                'ответ-исключение Modbus (код функции с битом 0x80)
#define CFG_TRIG_SILENCE_S 30               'тишина на линии дольше N секунд после того, как обмен шёл; 0 - не следить

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 0                         '1 - печатать события в консоль TIDE
