'=====================================================================
' Рецепт «Управление освещением» · события
'=====================================================================
include "global.tbh"

dim tick as byte = 0
dim ntp_sock as byte
dim ntp_timer as dword = 0
dim net_up as no_yes = NO

declare sub net_started()
declare sub ntp_request()

sub on_sys_init()
	sys.wdperiod = 1000
	sys.wdautoreset = DISABLED
	sys.wdenabled = YES
	sys.onsystimerperiod = 10           '100 мс

	pat.play("G-G-------", PL_PAT_CANINT)
	light_init()

	'два сокета под веб-сервер: страница и запрос с кнопки могут прийти одновременно
	dim i as byte
	dim s as byte
	for i = 1 to 2
		s = sock_get("WEB")
		sock.num = s
		sock.protocol = PL_SOCK_PROTOCOL_TCP
		sock.inconmode = PL_SOCK_INCONMODE_ANY_IP_ANY_PORT
		sock.httpmode = YES
		sock.httpportlist = CFG_HTTP_PORT
		sock.rxbuffrq(1)
		sock.txbuffrq(8)
		sock.varbuffrq(1)
	next i
	sys.buffalloc()

	ntp_sock = sock_get("NTP")
	sntp_init()

#if CFG_USE_DHCP
	dhcp_start(PL_SOCK_INTERFACE_NET, "", "")
#else
	net.ip = CFG_IP
	net.netmask = CFG_NETMASK
	net.gatewayip = CFG_GATEWAY
	net_started()
#endif
end sub

sub net_started()
	if net_up = YES then exit sub
	net_up = YES
	pat.play("~G", PL_PAT_CANINT)
	dbg("Lighting controller, web: http://" + net.ip + "/")
	ntp_request()
end sub

sub ntp_request()
	ntp_timer = sys.timercountms
	sntp_start(PL_SOCK_INTERFACE_NET, CFG_NTP_SERVER, 123, ntp_sock)
end sub

sub on_sys_timer()
	sys.wdreset()
	light_proc_timer()
	tick = tick + 1
	if tick >= 5 then
		tick = 0
		dhcp_proc_timer()
		sntp_proc_timer()
		if net_up = YES and sys.timercountms - ntp_timer > CFG_NTP_RESYNC_HOURS * 3600000 then ntp_request()
	end if
end sub

sub on_sock_data_arrival()
	dhcp_proc_data()
	sntp_proc_data()
end sub

sub on_sock_event(newstate as enum pl_sock_state, newstatesimple as enum pl_sock_state_simple)
	if sock.num = ntp_sock then sntp_proc_sock_event(newstatesimple)
end sub

'--- время ---
sub callback_sntp_ok(byref w_days as word, byref w_mins as word, byref b_seconds as byte)
	dim m as long = w_mins + CFG_TZ_MINUTES
	dim d as word = w_days
	if m >= 1440 then
		m = m - 1440
		d = d + 1
	else if m < 0 then
		m = m + 1440
		d = d - 1
	end if
	light_set_clock(d, m, b_seconds)
	ntp_ok = YES
	dbg("SNTP ok: " + light_clock_str())
end sub

sub callback_sntp_failure(sntp_status as en_sntp_status_codes)
	dbg("SNTP failed, code " + str(sntp_status))
	ntp_timer = sys.timercountms - CFG_NTP_RESYNC_HOURS * 3600000 + 600000     'повтор через 10 минут
end sub

sub callback_sntp_pre_buffrq(required_buff_pages as byte)
end sub

'--- сеть ---
sub callback_dhcp_ok(renew as no_yes, interface as pl_sock_interfaces, byref ip as string, byref gateway_ip as string, byref netmask as string, lease_time as dword)
	if renew = YES and net.ip = ip then exit sub
	net.ip = ip
	net.gatewayip = gateway_ip
	net.netmask = netmask
	net_started()
end sub

sub callback_dhcp_failure(interface as pl_sock_interfaces, failure_code as en_dhcp_status_codes)
	dbg("DHCP failed, library will retry")
end sub

sub callback_dhcp_pre_clear_ip(interface as pl_sock_interfaces)
end sub

sub callback_dhcp_pre_buffrq(required_buff_pages as byte)
end sub

sub callback_dhcp_buff_released()
end sub

function wln_check_association() as pl_wln_association_states
	wln_check_association = PL_WLN_NOT_ASSOCIATED
end function

sub dbg(byref s as string)
#if CFG_DEBUG
	sys.debugprint(s + chr(13) + chr(10))
#endif
end sub
