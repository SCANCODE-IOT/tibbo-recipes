'=====================================================================
' Рецепт «Управление освещением» · настройки
' 4 канала: реле -> катушки модульных контакторов 24 В, 4 кнопки (сухой контакт),
' веб-страница, расписание на каждый канал, синхронизация времени по SNTP.
' Расписание и режимы, заданные на веб-странице, хранятся в EEPROM.
'=====================================================================

'--- Сеть ---------------------------------------------------------------
#define CFG_USE_DHCP 1                      '1 - адрес по DHCP, 0 - статический адрес ниже
const CFG_IP = "192.168.1.201"
const CFG_NETMASK = "255.255.255.0"
const CFG_GATEWAY = "192.168.1.1"

'--- Время --------------------------------------------------------------
const CFG_NTP_SERVER = "162.159.200.1"      'IP SNTP-сервера (time.cloudflare.com); можно IP роутера
#define CFG_TZ_MINUTES 180                  'смещение от UTC в минутах: Москва +180
#define CFG_NTP_RESYNC_HOURS 12             'как часто сверять время

'--- Каналы -------------------------------------------------------------
'Названия для веб-страницы (латиница или кириллица в UTF-8, до 20 символов)
const CFG_NAME1 = "Фасад"
const CFG_NAME2 = "Парковка"
const CFG_NAME3 = "Холл"
const CFG_NAME4 = "Коридор"

'Расписание по умолчанию (до первого изменения на веб-странице), минуты от полуночи.
'Два окна на канал; одинаковые «вкл» и «выкл» - окно не используется. 18:00 = 1080, 07:00 = 420
#define CFG_DEF_ON1 1080
#define CFG_DEF_OFF1 420
#define CFG_DEF_ON2 0
#define CFG_DEF_OFF2 0

'--- Веб ----------------------------------------------------------------
#define CFG_HTTP_PORT "80"

'--- Отладка ------------------------------------------------------------
#define CFG_DEBUG 1
