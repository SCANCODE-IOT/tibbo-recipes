'=====================================================================
' Рецепт «Сбор данных 4-20 мА» · общий заголовок
' Плата TPP2(G2): #13 (АЦП) в S1, #12 (+-15 В для #13) в S3, #09 (12 В) в S11.
' Библиотеки 2_01_05 + драйвер tbt13 из актуальной библиотеки Tibbo.
'=====================================================================
include "config.tbh"

#define MQTT_DEBUG_PRINT 0
#define MQTT_RX_BUFF 2
#define MQTT_TX_BUFF 4
#define DHCP_DEBUG_PRINT 0
#define DNS_DEBUG_PRINT 0
#define DNS_DEFAULT_SERVER CFG_DNS_SERVER
#define SI2C_MAX_SIGNATURE_LEN 16
#define TBT13_DEBUG_PRINT 0

include "sock\trunk\sock.tbh"
include "dns\trunk\dns.tbh"
include "dhcp\trunk\dhcp.tbh"
include "mqtt\trunk\mqtt.tbh"
include "super_i2c\trunk\super_i2c.tbh"
include "ssi\trunk\ssi.tbh"
include "libraries/tbt13/tbt13.tbh"

#define CH_COUNT 4
#define HIST_LEN 1440                       'точек на канал: сутки по минуте

declare function wln_check_association() as pl_wln_association_states

'--- main.tbs ---
declare sub dbg(byref s as string)
declare function dev_id() as string
declare mqtt_online as no_yes

'--- daq.tbs ---
declare sub daq_init()
declare sub daq_proc_second()
declare function daq_now(ch as byte) as string
declare function daq_ma(ch as byte) as string
declare function daq_name(ch as byte) as string
declare function daq_unit(ch as byte) as string
declare function daq_hist(ch as byte, n as word) as string
declare daq_count as word
declare daq_fault(CH_COUNT) as no_yes
declare daq_minute_ready as no_yes

'--- web.tbs ---
declare function web_arg(byref rq as string, byref argname as string) as string
declare sub web_send(byref s as string)
